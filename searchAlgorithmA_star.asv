%Search algorithm which finds the optimal path between the start
%configuration and the goal configuration
%
%Input:
%'sp': As described in the file 'MotionPlannerSolution.m'
%
%
%Output:
%
%'solution': The solution for the search algorithm which contains the
%optimal path for the search algorithm, the heuristic, the cost, and f which is the priority for Astar [path, h, g, f]
%
%'expandedNodes': the number of expanded nodes to find the optimal solution
%
function [solution, expandedNodes] = searchAlgorithmA_star(sp, fringeSize, isDet)
    %{
    From maximum padding to minimum padding, run the algorithm and pick 
    the one with the best cost.
    %}
   %  solution = [];
   % 
   %  bestSol = [];
   %  bestCost = realmax;
   %  bestExpandedNodes = []; 
   % 
   %  fullRadius = sum(sp.design(:, 1));
   %  paddingAmount = 2 * pi * fullRadius * sp.stepSize(1) / 360; 
   %  minPadding = 2 * pi * min(sp.design(:, 1)) * sp.stepSize(1) / 360;
   % 
   %  modSp = sp;
   %  while paddingAmount >= minPadding
   %      modSp.obstacles(:, 4:5) = sp.obstacles(:, 4:5) + paddingAmount; % increases the radius and height so it makes the range that should be considered as collision
   %      if isDet
   %          [solution, expandedNodes] = searchAlgorithm_Det(modSp, fringeSize);
   %      else
   %          [solution, expandedNodes] = searchAlgorithm_Sto(modSp, fringeSize);
   %      end
   % 
   %      if ~isempty(solution) && solution.g < bestCost
   %          bestSol = solution;
   %          bestCost = solution.g;
   %          bestExpandedNodes = expandedNodes;
   %      end
   %      paddingAmount = paddingAmount / 2;
   %  end
   % 
   % solution = bestSol; 
   % expandedNodes = bestExpandedNodes;

   if isDet
       [solution, expandedNodes] = searchAlgorithm_Det(sp, fringeSize);
   else
       [solution, expandedNodes] = searchAlgorithm_Sto(sp, fringeSize);
   end
end

function [solution, expandedNodes] = searchAlgorithm_Sto(sp, fringeSize)
    expandedNodes = 0;
    root.g = 0;
    root.h = getHeuristic(sp, sp.start_conf, sp.goal_conf);
    root.f = calculateCostBasedOnAlgorithm(root.g, root.h, sp.typeOfAlg);
    root.path = sp.start_conf;
    fringe = PDQ_sto('init');
    PDQ_sto('add', fringe, {[root.f, root.g, root.h], root.path}); %Initiating the the priority deque which is a custom class implemented in c++ and used with a wrapper in matlab
    PDQ_sto('setMaxSize', fringe, fringeSize); %Set the max size of the priority deque
    set = java.util.HashSet; %A hashset used from the Java library to prevent cycles
    while ~PDQ_sto('empty', fringe)
        [priority, path] = PDQ_sto('poll', fringe);
        fringeNode.f = priority(1);
        fringeNode.g = priority(2);
        fringeNode.h = priority(3);
        fringeNode.path = path;
        set.add(mat2str(fringeNode.path(:,end-2:end))); %Getting the last configuration from the polled path
        expandedNodes = expandedNodes +1;
        if(fringeNode.h < sp.heuristicLimit)
            if size(sp.goals, 1) ~= 0
                sp.goals(1:sp.j, :) = [];
            end
            if size(sp.goals, 1) == 0 %Found the optimal path
                solution = fringeNode;
                return;
            else 
                PDQ_sto('clear', fringe);
                set.clear;
                sp.goal_conf = sp.goals(1:sp.j, 1:3);
                fringeNode.h = getHeuristic(sp, sp.start_conf, sp.goal_conf);
            end
        end
        [greedyChildren] = WrapperForOmersGreedyExpand(fringeNode, sp);
        validGreedyFound = false;
        for i = 1 :size(greedyChildren, 1)
            child = greedyChildren(i);
            [isColliding, ~] = collisionCheck(child.path(:,end-2:end), sp);%Checking if the greedy children are valid (not colliding), if not we will generate children according to the current algorithm [Astar, UCS, greedy]
            if ~set.contains(mat2str(child.path(:,end-2:end)))
                if isColliding == false
                    validGreedyFound = true;
                    PDQ_sto('add', fringe, {[child.f child.g child.h], child.path});
                    set.add(mat2str(child.path(:,end-2:end)));
                else
                    set.add(mat2str(child.path(:,end-2:end)));
                end
            end
        end
        if validGreedyFound == false %If no valid greedy children were found, we generate children according to the current algorithm [Astar, UCS, Greedy]
            children = fullExpand(sp, fringeNode);
            for i = 1 :size(children, 1)
                child = children(i);
                [isColliding, ~] = collisionCheck(child.path(:,end-2:end), sp);
                if ~set.contains(mat2str(child.path(:,end-2:end)))
                    if isColliding == false
                        PDQ_sto('add', fringe, {[child.f child.g child.h], child.path});
                        set.add(mat2str(child.path(:,end-2:end)));
                    else
                        set.add(mat2str(child.path(:,end-2:end)));
                    end
                end
            end
        end
        if PDQ_sto('empty', fringe)
            disp('no path found');
            solution = [];
        end
    end
    PDQ_sto('delete', fringe);
end

function [solution, expandedNodes] = searchAlgorithm_Det(sp, fringeSize)
    expandedNodes = 0;
    root.g = 0;
    root.h = getHeuristic(sp, sp.start_conf, sp.goal_conf);
    root.f = calculateCostBasedOnAlgorithm(root.g, root.h, sp.typeOfAlg);
    root.path = sp.start_conf;
    fringe = PDQ_det('init');
    PDQ_det('add', fringe, {[root.f, root.g, root.h], root.path}); %Initiating the the priority deque which is a custom class implemented in c++ and used with a wrapper in matlab
    PDQ_det('setMaxSize', fringe, fringeSize); %Set the max size of the priority deque
    set = java.util.HashSet; %A hashset used from the Java library to prevent cycles
    while ~PDQ_det('empty', fringe)
        [priority, path] = PDQ_det('poll', fringe);
        fringeNode.f = priority(1);
        fringeNode.g = priority(2);
        fringeNode.h = priority(3);
        fringeNode.path = path;
        set.add(mat2str(fringeNode.path(:,end-2:end))); %Getting the last configuration from the polled path
        expandedNodes = expandedNodes +1;
        if(fringeNode.h < sp.heuristicLimit)
            if size(sp.goals, 1) ~= 0
                sp.goals(1:sp.j, :) = [];
            end
            if size(sp.goals, 1) == 0 %Found the optimal path
                solution = fringeNode;
                return;
            else
                PDQ_det('clear', fringe);
                set.clear;
                sp.goal_conf = sp.goals(1:sp.j, 1:3);
                fringeNode.h = getHeuristic(sp, sp.start_conf, sp.goal_conf);
            end
        end
        [greedyChildren] = WrapperForOmersGreedyExpand(fringeNode, sp);
        validGreedyFound = false;
        for i = 1 :size(greedyChildren, 1)
            child = greedyChildren(i);
            [isColliding, ~] = collisionCheck(child.path(:,end-2:end), sp);%Checking if the greedy children are valid (not colliding), if not we will generate children according to the current algorithm [Astar, UCS, greedy]
            if ~set.contains(mat2str(child.path(:,end-2:end)))
                if isColliding == false
                    validGreedyFound = true;
                    PDQ_det('add', fringe, {[child.f child.g child.h], child.path});
                    set.add(mat2str(child.path(:,end-2:end)));
                else
                    set.add(mat2str(child.path(:,end-2:end)));
                end
            end
        end
        if validGreedyFound == false %If no valid greedy children were found, we generate children according to the current algorithm [Astar, UCS, Greedy]
            children = fullExpand(sp, fringeNode);
            for i = 1:size(children, 1)
                conf = children.path(:, end - 2:end);
                for j = size(conf, 1

                end
            end


            for i = 1:size(children, 1)
                child = children(i);
                [isColliding, ~] = collisionCheck(child.path(:,end-2:end), sp);
                if ~set.contains(mat2str(child.path(:,end-2:end)))
                    if isColliding == false
                        PDQ_det('add', fringe, {[child.f child.g child.h], child.path});
                        set.add(mat2str(child.path(:,end-2:end)));
                    else
                        set.add(mat2str(child.path(:,end-2:end)));
                    end
                end
            end
        end
        if PDQ_det('empty', fringe)
            disp('no path found');
            solution = [];
        end
    end
    PDQ_det('delete', fringe);
end


