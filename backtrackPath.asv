function [fullPath, totalCost] = backtrackPath(sp, graphTree)
    totalCost = 0;
    curNode = graphTree(end, :);
    fullPath = {};
    paths = {};
    while curNode{2} > 0
        parentNode = graphTree(curNode{2}, :);
        path = curNode{3};
        
        if isempty(path)
            fullPath = {};
            totalCost = -1;
            return;
        end

        % if isequal(path{1}, parentNode{1})
        %     path(1) = [];
        % end

        % path(1) = [];

        %%%
        
        if ~isempty(paths) && isequal(path{end}, paths{1})
            path{end
        end

        paths = [path, paths];
        if checkPath(sp, paths) ~= 0
            size(path, 2)
            paths{3}
            paths{4}
            calculateCost(sp, paths{3}, paths{4})
            return;
        end
        %%%
        
        curNode = parentNode;
    end
    % paths = flip(paths, 2);
    % for i = 1:size(paths, 2)
    %     fullPath = [fullPath, paths{i}];
    % end

    fullPath = paths;
    totalCost = costOfPath(sp, fullPath);
end